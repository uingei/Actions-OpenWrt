direct_host='/usr/share/passwall/rules/direct_host'
gfwlist='/usr/share/passwall/rules/gfwlist'
proxy_host='/usr/share/passwall/rules/proxy_host'

insert_line_top() {
    file=$1
    shift
    for line in "$@"; do
        grep -Fxq "$line" "$file" || sed -i "1i $line" "$file"
    done
}

# 删除 direct_host 中整行 'cn'
grep -Fxq 'cn' "$direct_host" && sed -i '/^cn$/d' "$direct_host"

# 插入 direct_host
insert_line_top "$direct_host" \
    www.msftncsi.com \
    www.msftconnecttest.com \
    dns.msftncsi.com

# 域名按条件插入 proxy_host（不在 gfwlist 且不在 proxy_host 时才插入）
conditionally_insert_to_proxy_host() {
    for line in "$@"; do
        if ! grep -Fxq "$line" "$gfwlist" && ! grep -Fxq "$line" "$proxy_host"; then
            sed -i "1i $line" "$proxy_host"
        fi
    done
}

# 执行插入逻辑
